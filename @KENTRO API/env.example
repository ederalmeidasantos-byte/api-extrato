# Configuração da API Kentro
# Copie este arquivo para .env e configure suas credenciais

# Ambiente (development, production)
NODE_ENV=development

# URLs da API
KENTRO_API_URL_DEV=https://api-kentro-test.lunas.com.br/v1
KENTRO_API_URL_PROD=https://api-kentro.lunas.com.br/v1

# Autenticação
KENTRO_TOKEN=your_bearer_token_here
KENTRO_API_KEY=your_api_key_here

# Webhook
KENTRO_WEBHOOK_SECRET=your_webhook_secret_here
KENTRO_WEBHOOK_URL=https://seu-sistema.com/webhook/kentro

# Rate Limiting
KENTRO_RATE_LIMIT_DISPARAR=100
KENTRO_RATE_LIMIT_CONTRATO=50
KENTRO_RATE_LIMIT_CONSULTAS=200
KENTRO_RATE_WINDOW=60000

# Retry Configuration
KENTRO_MAX_RETRIES=3
KENTRO_RETRY_DELAY=1000

# Timeout
KENTRO_TIMEOUT=30000

# Logging
KENTRO_LOG_LEVEL=debug
KENTRO_LOG_FORMAT=json

# Monitoramento
KENTRO_MONITORING_ENABLED=true
KENTRO_METRICS_ENABLED=true

# Alertas
KENTRO_ALERT_ERROR_RATE=0.05
KENTRO_ALERT_RESPONSE_TIME=5000
KENTRO_ALERT_AVAILABILITY=0.99

# Banco de Dados (para integração)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kentro_integration
DB_USER=postgres
DB_PASSWORD=your_db_password

# Redis (para cache e rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Sistema Operacional
OPERACIONAL_API_URL=http://localhost:3000
OPERACIONAL_API_KEY=your_operacional_api_key

# Notificações
NOTIFICATION_EMAIL=admin@lunas.com.br
NOTIFICATION_SLACK_WEBHOOK=https://hooks.slack.com/services/...
NOTIFICATION_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Desenvolvimento
DEBUG=kentro:*
VERBOSE=true



