{
  "name": "kentro-api-integration",
  "version": "1.0.0",
  "description": "Integração da API Kentro com Sistema Operacional FGTS",
  "main": "kentro-client.js",
  "scripts": {
    "start": "node examples.js",
    "test": "jest test-kentro.js",
    "test:watch": "jest test-kentro.js --watch",
    "test:coverage": "jest test-kentro.js --coverage",
    "lint": "eslint *.js",
    "lint:fix": "eslint *.js --fix",
    "docs": "jsdoc -d docs *.js",
    "dev": "nodemon examples.js"
  },
  "keywords": [
    "kentro",
    "api",
    "fgts",
    "integracao",
    "sistema-operacional",
    "lunas"
  ],
  "author": "Lunas Digital",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.2",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lunas-digital/kentro-api-integration.git"
  },
  "bugs": {
    "url": "https://github.com/lunas-digital/kentro-api-integration/issues"
  },
  "homepage": "https://github.com/lunas-digital/kentro-api-integration#readme",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "*.js",
      "!test-*.js",
      "!examples.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "rules": {
      "indent": [
        "error",
        2
      ],
      "linebreak-style": [
        "error",
        "unix"
      ],
      "quotes": [
        "error",
        "single"
      ],
      "semi": [
        "error",
        "always"
      ],
      "no-unused-vars": "warn",
      "no-console": "off"
    }
  }
}



