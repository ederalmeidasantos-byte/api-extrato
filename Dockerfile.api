FROM node:18-alpine

RUN apk add --no-cache curl bash

RUN addgroup -g 1001 -S nodejs && \
    adduser -S api -u 1001

WORKDIR /app

COPY package-api.json package.json
RUN npm install --only=production && npm cache clean --force

COPY api-extrair-calculo.js ./
COPY INSS/extrair_pdf.js ./INSS/
COPY INSS/calculo.js ./INSS/
COPY INSS/beneficios.js ./INSS/
COPY INSS/bancos.js ./INSS/

RUN mkdir -p /app/var/data/extratos && \
    chown -R api:nodejs /app && \
    chown -R api:nodejs /app/var

USER api

EXPOSE 3003

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3003/health || exit 1

CMD ["node", "api-extrair-calculo.js"]