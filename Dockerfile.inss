FROM node:18-alpine

WORKDIR /app

# Instalar dependências do sistema
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    musl-dev \
    giflib-dev \
    pixman-dev \
    pangomm-dev \
    libjpeg-turbo-dev \
    freetype-dev

# Copiar package.json e instalar dependências
COPY package*.json ./
RUN npm install --omit=dev

# Copiar código fonte
COPY . .

# Criar diretórios necessários
RUN mkdir -p /app/var/data/clientes /app/var/data/propostas /app/var/data/backup

# Expor porta
EXPOSE 3002

# Comando para iniciar o servidor INSS
CMD ["node", "INSS/server-inss.js"]