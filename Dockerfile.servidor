FROM node:18-alpine

WORKDIR /app

# Copiar package.json e instalar dependências
COPY package*.json ./
RUN npm ci --only=production

# Copiar código do servidor principal
COPY server.js ./
COPY INSS/ ./INSS/
COPY operacional/ ./operacional/
COPY fgts/ ./fgts/
COPY assets/ ./assets/

# Criar diretórios necessários
RUN mkdir -p var/data/{clientes,propostas,extratos,uploads,tenants}
RUN mkdir -p logs

# Expor porta
EXPOSE 3000

# Comando para iniciar o servidor principal
CMD ["node", "server.js"]

