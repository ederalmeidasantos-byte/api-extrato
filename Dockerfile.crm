FROM node:18-alpine

WORKDIR /app

# Instalar dependências do sistema
RUN apk add --no-cache \
    python3 \
    make \
    g++

# Copiar package.json e instalar dependências
COPY package*.json ./
RUN npm install --omit=dev

# Copiar código fonte
COPY . .

# Criar diretórios necessários
RUN mkdir -p /app/var/data/clientes /app/var/data/propostas /app/var/data/backup

# Expor porta
EXPOSE 3001

# Comando para iniciar o servidor CRM
CMD ["node", "operacional/server-crm.js"]