# ===== CONFIGURAÇÕES PARA ARQUITETURA MULTI-CONTAINER =====
# Arquitetura VPS Reestruturada - Lunas Digital
# Copie este arquivo para .env e configure suas credenciais

# ===== CONFIGURAÇÕES DE PORTAS =====
# Servidor Principal (API + Simulador)
PORT_SERVIDOR_PRINCIPAL=3000
# CRM (Sistema Operacional)
PORT_CRM=3001
# API + Simulador HTML
PORT_API_SIMULADOR=3002
# Base de Dados (Clientes + Propostas)
PORT_BASE_DADOS=3003
# Disparador WhatsApp (Sistema Kentro)
PORT_WHATSAPP_DISPATCHER=3004
# Nginx (Load Balancer)
PORT_NGINX=80

# ===== CONFIGURAÇÕES DE AMBIENTE =====
NODE_ENV=production
JWT_SECRET=lunas_digital_jwt_secret_2025

# ===== CONFIGURAÇÕES DE BASE DE DADOS =====
# URL da base de dados (para containers)
DB_SERVICE_URL=http://base-dados:3003
# URL da base de dados (para desenvolvimento local)
DB_SERVICE_URL_LOCAL=http://localhost:3003

# ===== API LUNAS CRM (KENTRO) =====
LUNAS_API_URL=https://api.lunasdigital.com.br
LUNAS_API_KEY=sua_chave_api_lunas
LUNAS_QUEUE_ID=25
LUNAS_DEST_STAGE_ID=4

# ===== DISPARADOR WHATSAPP (KENTRO) =====
KENTRO_API_KEY=cd4d0509169d4e2ea9177ac66c1c9376
KENTRO_QUEUE_ID=25
KENTRO_TEMPLATE_ID=99
DISPATCH_DELAY=2000
MAX_RETRIES=3
MAX_BATCH_SIZE=1000
ALLOWED_ORIGINS=http://localhost:3004,http://IP_DO_SERVIDOR:3004,http://IP_DO_SERVIDOR:80

# ===== OPENAI (para extração de PDF) =====
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4000

# ===== API V8 SISTEMA (para consultas FGTS) =====
V8_API_BASE=https://bff.v8sistema.com
V8_AUTH_URL=https://auth.v8sistema.com/oauth/token
V8_CLIENT_ID=DHWogdaYmEI8n5bwwxPDzulMlSK7dwIn
V8_AUDIENCE=https://bff.v8sistema.com
V8_USERNAME=seu_email_v8@dominio.com
V8_PASSWORD=sua_senha_v8

# ===== CONFIGURAÇÕES FGTS =====
FGTS_USER_1=seu_usuario_fgts_1@email.com
FGTS_PASS_1=sua_senha_fgts_1
FGTS_USER_2=seu_usuario_fgts_2@email.com
FGTS_PASS_2=sua_senha_fgts_2
FGTS_USER_3=seu_usuario_fgts_3@email.com
FGTS_PASS_3=sua_senha_fgts_3

# ===== CONFIGURAÇÕES DE PERFORMANCE =====
DEFAULT_DELAY=1000
DELAY_BASE=1000
DELAY_MIN=500
DELAY_MAX=5000
TAXA_ERRO=10

# ===== CONFIGURAÇÕES DE HORÁRIO COMERCIAL =====
HORARIO_INICIO=08:00
HORARIO_FIM=22:00
FUSO_HORARIO=America/Sao_Paulo

# ===== CONFIGURAÇÕES DE WEBHOOK (opcional) =====
WEBHOOK_BASE_URL=https://lunasdigital.com.br

# ===== OPENAI (opcional - apenas se usar extração de PDF) =====
OPENAI_API_KEY=sua_chave_openai

# ===== CONFIGURAÇÕES DE LOG =====
LOG_LEVEL=info
LOG_MAX_FILES=10
LOG_MAX_SIZE=10m

# ===== CONFIGURAÇÕES DE CONTAINER =====
# Nome do container atual (será definido pelo docker-compose)
CONTAINER_NAME=servidor-principal
# Rede Docker
DOCKER_NETWORK=lunas-network

# ===== CONFIGURAÇÕES DE CACHE =====
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ===== CONFIGURAÇÕES DE SEGURANÇA =====
CORS_ORIGIN=https://lunasdigital.com.br,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ===== CONFIGURAÇÕES DE BACKUP =====
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30

# ===== CONFIGURAÇÕES DE MONITORAMENTO =====
HEALTH_CHECK_INTERVAL=30s
METRICS_ENABLED=true
ALERT_EMAIL=admin@lunasdigital.com.br

# ===== CONFIGURAÇÕES DE SSL (para produção) =====
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
SSL_ENABLED=true

# ===== CONFIGURAÇÕES DE DOMÍNIO =====
DOMAIN=lunasdigital.com.br
WWW_DOMAIN=www.lunasdigital.com.br
SUBDOMAIN_API=api.lunasdigital.com.br
SUBDOMAIN_CRM=crm.lunasdigital.com.br
SUBDOMAIN_SIMULADOR=simulador.lunasdigital.com.br
