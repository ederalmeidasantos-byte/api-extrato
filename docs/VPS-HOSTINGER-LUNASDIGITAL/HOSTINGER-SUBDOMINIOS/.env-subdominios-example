# Configuração de Ambiente para Subdomínios - Hostinger VPS
# Copie este arquivo para .env e configure as variáveis

# ===========================================
# CONFIGURAÇÕES GERAIS
# ===========================================
NODE_ENV=production
PORT=3000
SUBDOMINIO=api

# ===========================================
# CONFIGURAÇÕES DE SUBDOMÍNIOS
# ===========================================
# API Principal
API_PRINCIPAL_PORT=3000
API_PRINCIPAL_SUBDOMINIO=api

# Sistema FGTS
FGTS_PORT=3001
FGTS_SUBDOMINIO=fgts

# Sistema INSS
INSS_PORT=3002
INSS_SUBDOMINIO=inss

# Painel Admin
ADMIN_PORT=3003
ADMIN_SUBDOMINIO=admin

# ===========================================
# CONFIGURAÇÕES DE DOMÍNIO
# ===========================================
DOMINIO_PRINCIPAL=seudominio.com
API_DOMINIO=api.seudominio.com
FGTS_DOMINIO=fgts.seudominio.com
INSS_DOMINIO=inss.seudominio.com
ADMIN_DOMINIO=admin.seudominio.com

# ===========================================
# CONFIGURAÇÕES DE BANCO DE DADOS
# ===========================================
# (Configure conforme sua necessidade)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=api_extrato
DB_USER=root
DB_PASSWORD=sua_senha_aqui

# ===========================================
# CONFIGURAÇÕES DE CACHE
# ===========================================
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=100

# ===========================================
# CONFIGURAÇÕES DE LOGS
# ===========================================
LOG_LEVEL=info
LOG_FILE=/var/log/api/app.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# ===========================================
# CONFIGURAÇÕES DE SEGURANÇA
# ===========================================
JWT_SECRET=sua_chave_secreta_jwt_aqui
ENCRYPTION_KEY=sua_chave_criptografia_aqui
CORS_ORIGIN=*

# ===========================================
# CONFIGURAÇÕES DE UPLOAD
# ===========================================
UPLOAD_MAX_SIZE=100MB
UPLOAD_PATH=/var/data/uploads
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png

# ===========================================
# CONFIGURAÇÕES DE EMAIL (opcional)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_app

# ===========================================
# CONFIGURAÇÕES DE MONITORAMENTO
# ===========================================
HEALTH_CHECK_INTERVAL=30000
MONITORING_ENABLED=true
METRICS_ENABLED=true

# ===========================================
# CONFIGURAÇÕES DE SSL
# ===========================================
SSL_ENABLED=false
SSL_CERT_PATH=/etc/letsencrypt/live/seudominio.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/seudominio.com/privkey.pem

# ===========================================
# CONFIGURAÇÕES DE BACKUP
# ===========================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_PATH=/var/data/backups
BACKUP_RETENTION_DAYS=30

# ===========================================
# CONFIGURAÇÕES DE RATE LIMITING
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# CONFIGURAÇÕES ESPECÍFICAS POR SUBDOMÍNIO
# ===========================================
# API Principal
API_PRINCIPAL_CORS_ORIGIN=*
API_PRINCIPAL_RATE_LIMIT=1000

# Sistema FGTS
FGTS_CORS_ORIGIN=*
FGTS_RATE_LIMIT=500
FGTS_SPECIFIC_CONFIG=valor_especifico_fgts

# Sistema INSS
INSS_CORS_ORIGIN=*
INSS_RATE_LIMIT=500
INSS_SPECIFIC_CONFIG=valor_especifico_inss

# Painel Admin
ADMIN_CORS_ORIGIN=admin.seudominio.com
ADMIN_RATE_LIMIT=200
ADMIN_AUTH_REQUIRED=true
