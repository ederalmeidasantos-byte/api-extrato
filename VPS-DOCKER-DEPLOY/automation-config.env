# 🚀 Configuração da Automação VPS + Docker
# Arquivo de configuração para a automação completa

# ================== CONFIGURAÇÕES VPS ==================

# API Hostinger
HOSTINGER_API_TOKEN="llr3i3O4HmftTCx0uuNzRNpjHkM1wnsmfyEkFNjC5e9050c2"
HOSTINGER_BASE_URL="https://developers.hostinger.com/api/vps/v1"
VPS_ID="1035582"
VPS_IP="72.60.159.149"
VPS_HOSTNAME="api.lunasdigital"

# ================== CONFIGURAÇÕES DOCKER ==================

# Containers principais
CRM_CONTAINER="crm-lunas-digital"
INSS_CONTAINER="inss-lunas-digital"
NGINX_CONTAINER="nginx-lunas-digital"

# Portas dos serviços
CRM_PORT="3001"
INSS_PORT="3002"
NGINX_PORT="80"
NGINX_SSL_PORT="443"

# Diretórios dos projetos
CRM_PATH="/opt/lunasdigital/crm-lunasdigital"
INSS_PATH="/opt/lunasdigital/inss-simulador"
NGINX_CONFIG_PATH="/etc/nginx/sites-available/lunasdigital"

# ================== CONFIGURAÇÕES DE BACKUP ==================

# Diretório de backups
BACKUP_DIR="/opt/lunasdigital/backups"
BACKUP_RETENTION_DAYS="30"

# Configurações de backup automático
AUTO_BACKUP_ENABLED="true"
AUTO_BACKUP_TIME="02:00"
AUTO_BACKUP_DAYS="1,2,3,4,5"  # Dias da semana (1=segunda, 7=domingo)

# ================== CONFIGURAÇÕES DE MONITORAMENTO ==================

# Intervalo de monitoramento (em segundos)
MONITORING_INTERVAL="60"

# Configurações de alertas
ALERT_EMAIL="suporte@lunasdigital.com.br"
ALERT_SMS_ENABLED="false"
ALERT_SMS_NUMBER="+5511959088554"

# Thresholds para alertas
CPU_THRESHOLD="80"
MEMORY_THRESHOLD="85"
DISK_THRESHOLD="90"

# ================== CONFIGURAÇÕES DE DEPLOY ==================

# Configurações de deploy
DEPLOY_TIMEOUT="300"  # 5 minutos
DEPLOY_RETRY_COUNT="3"
DEPLOY_ROLLBACK_ENABLED="true"

# Configurações de build
DOCKER_BUILD_NO_CACHE="true"
DOCKER_BUILD_PARALLEL="false"

# ================== CONFIGURAÇÕES DE SEGURANÇA ==================

# Configurações de autenticação
API_AUTH_REQUIRED="true"
API_RATE_LIMIT="100"  # Requisições por hora
API_RATE_WINDOW="3600"  # Janela em segundos

# Configurações de firewall
FIREWALL_ENABLED="true"
ALLOWED_IPS="0.0.0.0/0"  # IPs permitidos (separados por vírgula)

# ================== CONFIGURAÇÕES DE LOGS ==================

# Configurações de logging
LOG_LEVEL="INFO"  # DEBUG, INFO, WARN, ERROR
LOG_FILE="/opt/lunasdigital/logs/automation.log"
LOG_MAX_SIZE="10MB"
LOG_MAX_FILES="5"

# Configurações de rotação de logs
LOG_ROTATION_ENABLED="true"
LOG_ROTATION_SCHEDULE="daily"

# ================== CONFIGURAÇÕES DE NOTIFICAÇÕES ==================

# Configurações de email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@lunasdigital.com.br"
SMTP_PASS="sua_senha_aqui"
SMTP_TLS="true"

# Configurações de webhook
WEBHOOK_ENABLED="false"
WEBHOOK_URL="https://hooks.slack.com/services/..."
WEBHOOK_TIMEOUT="30"

# ================== CONFIGURAÇÕES DE PERFORMANCE ==================

# Configurações de cache
CACHE_ENABLED="true"
CACHE_TTL="300"  # 5 minutos
CACHE_MAX_SIZE="100MB"

# Configurações de conexão
CONNECTION_TIMEOUT="30"
CONNECTION_RETRY_COUNT="3"
CONNECTION_RETRY_DELAY="5"

# ================== CONFIGURAÇÕES DE DESENVOLVIMENTO ==================

# Configurações de debug
DEBUG_MODE="false"
VERBOSE_LOGGING="false"
DRY_RUN="false"

# Configurações de teste
TEST_MODE="false"
TEST_VPS_ID="test-123"
TEST_CONTAINER_PREFIX="test-"

# ================== CONFIGURAÇÕES DE INTEGRAÇÃO ==================

# Configurações de integração com outros sistemas
INTEGRATION_WEBHOOKS_ENABLED="false"
INTEGRATION_API_ENABLED="true"
INTEGRATION_METRICS_ENABLED="true"

# Configurações de métricas
METRICS_ENDPOINT="/api/metrics"
METRICS_INTERVAL="60"
METRICS_RETENTION="7d"

# ================== CONFIGURAÇÕES DE MANUTENÇÃO ==================

# Configurações de limpeza automática
AUTO_CLEANUP_ENABLED="true"
AUTO_CLEANUP_SCHEDULE="0 3 * * *"  # Todo dia às 3h
CLEANUP_DOCKER_IMAGES="true"
CLEANUP_DOCKER_CONTAINERS="true"
CLEANUP_DOCKER_VOLUMES="false"  # Cuidado com dados!

# Configurações de atualização
AUTO_UPDATE_ENABLED="false"
UPDATE_CHECK_SCHEDULE="0 1 * * 0"  # Todo domingo às 1h
UPDATE_NOTIFICATION_ENABLED="true"

# ================== CONFIGURAÇÕES DE BACKUP CLOUD ==================

# Configurações de backup na nuvem
CLOUD_BACKUP_ENABLED="false"
CLOUD_PROVIDER="aws"  # aws, gcp, azure
CLOUD_BUCKET="lunasdigital-backups"
CLOUD_REGION="us-east-1"

# Credenciais cloud (usar variáveis de ambiente em produção)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"

# ================== CONFIGURAÇÕES DE SSL ==================

# Configurações SSL
SSL_ENABLED="true"
SSL_CERT_PATH="/etc/nginx/ssl"
SSL_RENEWAL_ENABLED="true"
SSL_RENEWAL_SCHEDULE="0 2 * * 0"  # Todo domingo às 2h

# Configurações Let's Encrypt
LETSENCRYPT_ENABLED="true"
LETSENCRYPT_EMAIL="admin@lunasdigital.com.br"
LETSENCRYPT_STAGING="false"

# ================== CONFIGURAÇÕES DE DOMÍNIOS ==================

# Domínios configurados
DOMAINS_CRM="crm.lunasdigital.com.br"
DOMAINS_INSS="inss.lunasdigital.com.br"
DOMAINS_API="api.lunasdigital.com.br"

# Configurações DNS
DNS_PROVIDER="cloudflare"  # cloudflare, route53, etc
DNS_TTL="300"
DNS_AUTO_UPDATE="false"

# ================== CONFIGURAÇÕES DE ALERTAS ==================

# Configurações de alertas por serviço
ALERT_SERVICE_DOWN="true"
ALERT_HIGH_CPU="true"
ALERT_HIGH_MEMORY="true"
ALERT_DISK_FULL="true"
ALERT_SSL_EXPIRING="true"

# Configurações de alertas por container
ALERT_CONTAINER_DOWN="true"
ALERT_CONTAINER_RESTART="true"
ALERT_CONTAINER_ERROR="true"

# Configurações de alertas por VPS
ALERT_VPS_DOWN="true"
ALERT_VPS_RESTART="true"
ALERT_VPS_HIGH_RESOURCES="true"

# ================== CONFIGURAÇÕES DE RELATÓRIOS ==================

# Configurações de relatórios
REPORTS_ENABLED="true"
REPORTS_SCHEDULE="0 8 * * 1"  # Toda segunda às 8h
REPORTS_EMAIL="relatorios@lunasdigital.com.br"

# Tipos de relatórios
REPORT_SYSTEM_STATUS="true"
REPORT_PERFORMANCE="true"
REPORT_SECURITY="true"
REPORT_BACKUP="true"

# ================== CONFIGURAÇÕES DE AUDITORIA ==================

# Configurações de auditoria
AUDIT_ENABLED="true"
AUDIT_LOG_FILE="/opt/lunasdigital/logs/audit.log"
AUDIT_RETENTION_DAYS="90"

# Eventos auditados
AUDIT_VPS_ACTIONS="true"
AUDIT_DOCKER_ACTIONS="true"
AUDIT_BACKUP_ACTIONS="true"
AUDIT_DEPLOY_ACTIONS="true"
AUDIT_CONFIG_CHANGES="true"

# ================== CONFIGURAÇÕES DE DESENVOLVIMENTO ==================

# Configurações para desenvolvimento
DEV_MODE="false"
DEV_VPS_ID="dev-123"
DEV_CONTAINER_PREFIX="dev-"
DEV_LOG_LEVEL="DEBUG"

# Configurações de teste
TEST_ENABLED="false"
TEST_CONTAINERS="test-crm,test-inss"
TEST_TIMEOUT="60"

# ================== CONFIGURAÇÕES DE PRODUÇÃO ==================

# Configurações para produção
PROD_MODE="true"
PROD_BACKUP_ENCRYPTION="true"
PROD_LOG_LEVEL="INFO"
PROD_MONITORING_ENABLED="true"

# Configurações de alta disponibilidade
HA_ENABLED="false"
HA_PRIMARY_VPS="1035582"
HA_SECONDARY_VPS=""
HA_FAILOVER_ENABLED="false"

# ================== CONFIGURAÇÕES DE COMPLIANCE ==================

# Configurações de compliance
COMPLIANCE_ENABLED="false"
COMPLIANCE_STANDARD="ISO27001"  # ISO27001, SOC2, PCI-DSS
COMPLIANCE_AUDIT_SCHEDULE="0 0 1 * *"  # Todo dia 1 do mês

# Configurações de retenção
DATA_RETENTION_DAYS="365"
LOG_RETENTION_DAYS="90"
BACKUP_RETENTION_DAYS="30"

# ================== CONFIGURAÇÕES DE INTEGRAÇÃO EXTERNA ==================

# Configurações de integração com sistemas externos
EXTERNAL_MONITORING_ENABLED="false"
EXTERNAL_MONITORING_URL=""
EXTERNAL_MONITORING_API_KEY=""

# Configurações de webhook externo
EXTERNAL_WEBHOOK_ENABLED="false"
EXTERNAL_WEBHOOK_URL=""
EXTERNAL_WEBHOOK_SECRET=""

# ================== CONFIGURAÇÕES DE CUSTOMIZAÇÃO ==================

# Configurações customizadas
CUSTOM_SCRIPTS_ENABLED="false"
CUSTOM_SCRIPTS_PATH="/opt/lunasdigital/custom-scripts"
CUSTOM_SCRIPTS_TIMEOUT="300"

# Configurações de plugins
PLUGINS_ENABLED="false"
PLUGINS_PATH="/opt/lunasdigital/plugins"
PLUGINS_AUTO_UPDATE="false"

# ================== FIM DAS CONFIGURAÇÕES ==================

# Para usar este arquivo, copie para .env e ajuste as configurações conforme necessário
# Exemplo: cp automation-config.env .env
# Depois edite o arquivo .env com suas configurações específicas
